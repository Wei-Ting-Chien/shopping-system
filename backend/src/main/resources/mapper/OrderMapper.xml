<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shopping.system.mapper.OrderMapper">

    <resultMap id="OrderResultMap" type="com.shopping.system.model.Order">
        <id property="id" column="id" />
        <result property="customerName" column="customer_name" />
        <result property="customerPhone" column="customer_phone" />
        <result property="customerLocation" column="customer_location" />
        <result property="totalAmount" column="total_amount" />
        <result property="status" column="status" />
        <result property="createAt" column="create_at" />
        <result property="updateAt" column="update_at" />

        <collection property="orderItems" ofType="com.shopping.system.model.OrderItem">
            <id property="id" column="item_id" /> <result property="orderId" column="order_id" />
            <result property="productId" column="product_id" />
            <result property="productName" column="product_name" />
            <result property="price" column="price" />
            <result property="quantity" column="quantity" />
        </collection>
    </resultMap>

    <insert id="insertOrder" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO orders (customer_name, customer_phone, customer_location, total_amount, status, create_at, update_at)
        VALUES (#{customerName}, #{customerPhone}, #{customerLocation}, #{totalAmount}, #{status}, NOW(), NOW())
    </insert>

    <insert id="insertOrderItems">
        INSERT INTO order_item (order_id, product_id, product_name, price, quantity)
        VALUES
        <foreach collection="items" item="item" separator=",">
            (#{item.orderId}, #{item.productId}, #{item.productName}, #{item.price}, #{item.quantity})
        </foreach>
    </insert>

    <select id="selectById" resultMap="OrderResultMap">
        SELECT 
            o.*, 
            oi.id AS item_id,  oi.order_id, 
            oi.product_id, 
            oi.product_name, 
            oi.price, 
            oi.quantity
        FROM orders o
        LEFT JOIN order_item oi ON o.id = oi.order_id
        WHERE o.id = #{id}
    </select>

    <select id="selectAll" resultType="com.shopping.system.model.Order">
        SELECT * FROM orders ORDER BY create_at DESC
    </select>

</mapper>